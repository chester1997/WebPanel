// ==========================================
// PLATAFORMA & MULTI-TENANCY
// ==========================================

// Papéis de tenant (loja). SUPER_ADMIN é um atributo de plataforma no
// próprio User (User.isSuperAdmin), não um papel de Membership — controla
// toda a plataforma e não está preso a um tenant específico.
enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id                String   @id @default(uuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  phone             String?
  telegramId        String?  @unique
  telegramUsername  String?
  status            String   @default("ACTIVE") // ACTIVE, SUSPENDED
  isSuperAdmin      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt temporal.updatedAt()
  memberships       Membership[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[] @relation("TicketCreator")
  ticketReplies     SupportTicketReply[]
}

// Tokens de verificação de e-mail / recuperação de senha
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  createdAt   DateTime @default(now())
  updatedAt temporal.updatedAt()
  memberships Membership[]

  // Entidades comerciais e de configuração
  bots                  Bot[]
  miniAppSettings       MiniAppSettings[]
  products              Product[]
  categories            Category[]
  coupons               Coupon[]
  contents              Content[]
  customers             Customer[]
  orders                Order[]
  payments              Payment[]
  subscriptions         Subscription[]
  paymentConnections    PaymentGatewayConnection[]
  webhookEvents         WebhookEvent[]
  notifications         Notification[]
  automations           Automation[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  platformSubscriptions PlatformSubscription[]
  platformPayments      PlatformPayment[]
  affiliates            Affiliate[]
  billingReminderSettings BillingReminderSettings?
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// ==========================================
// BILLING DA PLATAFORMA (O VENDEDOR PAGA A PLATAFORMA)
// ==========================================

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique // STARTER, PRO, BUSINESS
  price       Float
  currency    String   @default("BRL")
  features    Json     // Ex: { "maxBots": 1, "maxProducts": 50 }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt temporal.updatedAt()
  platformSubscriptions PlatformSubscription[]
  platformPayments      PlatformPayment[]
}

model PlatformSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  planId    String
  status    String   // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  startedAt DateTime @default(now())
  expiresAt DateTime
  renewalAt DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

// Cobrança PIX de uma assinatura da plataforma (o vendedor pagando a Webi/
// WebPanel) — gerada com a conta Mercado Pago da própria plataforma, nunca
// com a conta do tenant.
model PlatformPayment {
  id         String   @id @default(uuid())
  tenantId   String
  planId     String
  externalId String?  // ID do pagamento no Mercado Pago
  amount     Float
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  paymentUrl String?
  createdAt  DateTime @default(now())
  updatedAt temporal.updatedAt()

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       Plan     @relation(fields: [planId], references: [id])
}

// ==========================================
// TELEGRAM BOT & MINI APP
// ==========================================

model Bot {
  id               String   @id @default(uuid())
  tenantId         String
  botToken         String   // Criptografado - nunca exposto ao client
  telegramBotId    String?  @unique
  username         String
  name             String
  status           String   @default("ACTIVE") // ACTIVE, ERROR, DISABLED
  createdAt        DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config           BotConfiguration?
  webhook          TelegramWebhook?
  miniAppSettings  MiniAppSettings?
  products         ProductBot[]
}

model BotConfiguration {
  id               String  @id @default(uuid())
  botId            String  @unique
  welcomeMsg       String?
  notifyTelegramId String? // Telegram ID do vendedor que recebe aviso de cada venda

  bot              Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model TelegramWebhook {
  id       String  @id @default(uuid())
  botId    String  @unique
  url      String
  secret   String  // Usado para validar a origem do request do Telegram
  isActive Boolean @default(true)

  bot      Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model MiniAppSettings {
  id             String  @id @default(uuid())
  tenantId       String  
  botId          String? @unique
  slug           String  @unique // Slug gerado unico para a loja deste bot ou tenant
  buttonText     String? @default("Abrir App")
  storeName      String
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  description    String?

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bot            Bot?    @relation(fields: [botId], references: [id], onDelete: Cascade)
  banners        MiniAppBanner[]
  sections       MiniAppSection[]
}

model MiniAppBanner {
  id         String  @id @default(uuid())
  settingsId String
  imageUrl   String
  linkUrl    String?
  order      Int     @default(0)
  isActive   Boolean @default(true)

  settings   MiniAppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model MiniAppSection {
  id         String  @id @default(uuid())
  settingsId String
  title      String
  type       String  // TOP_10, CATEGORY, RECENT
  order      Int     @default(0)
  isActive   Boolean @default(true)

  settings   MiniAppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

// ==========================================
// PRODUTOS E CATÁLOGO
// ==========================================

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  order       Int      @default(0)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
}

model ProductBot {
  id        String  @id @default(uuid())
  productId String
  botId     String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bot       Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([productId, botId])
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  categoryId       String?
  title            String
  slug             String
  description      String?
  imageUrl         String?
  status           String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  type             String   // DIGITAL, SUBSCRIPTION, BUNDLE, ACCESS
  periodicity      String?  // ONE_TIME, MONTHLY, QUARTERLY, SEMIANNUAL, YEARLY, LIFETIME
  deliveryType     String   // TELEGRAM_GROUP, TELEGRAM_CHANNEL, EXTERNAL_LINK, MINI_APP_CONTENT, FILE
  deliveryContent  String?  // ID do grupo/canal, link externo, contentId, etc.
  showInGeneralStore Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category? @relation(fields: [categoryId], references: [id])
  prices           ProductPrice[]
  orderItems       OrderItem[]
  customerAccesses CustomerAccess[]
  coupons          Coupon[]
  bots             ProductBot[]
}

model ProductPrice {
  id               String  @id @default(uuid())
  productId        String
  price            Float
  promotionalPrice Float?
  currency         String  @default("BRL")
  isActive         Boolean @default(true)

  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id         String    @id @default(uuid())
  tenantId   String
  productId  String?
  code       String
  type       String    // PERCENTAGE, FIXED
  value      Float
  usageLimit Int?
  usageCount Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id])
}

// ==========================================
// CONTEÚDO DIGITAL (Player na Mini App)
// ==========================================

model Content {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  imageUrl    String?
  type        String   // MOVIE, SERIES, COURSE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seasons     Season[]
  media       Media?   // usado quando type == MOVIE
}

model Season {
  id        String  @id @default(uuid())
  contentId String
  title     String
  order     Int     @default(0)

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes  Episode[]
}

model Episode {
  id          String  @id @default(uuid())
  seasonId    String
  title       String
  description String?
  order       Int     @default(0)
  thumbnail   String?

  season      Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  media       Media?
}

model Media {
  id             String   @id @default(uuid())
  contentId      String?  @unique
  episodeId      String?  @unique
  videoUrl       String?
  telegramFileId String?
  duration       Int?     // em segundos

  content        Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode        Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

// ==========================================
// CLIENTES, PEDIDOS E PAGAMENTOS
// ==========================================

model Customer {
  id               String   @id @default(uuid())
  tenantId         String
  name             String?
  email            String?
  telegramId       String   // ID vindo da Mini App / Bot (initData)
  telegramUsername String?
  status           String   @default("ACTIVE")
  totalSpent       Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  subscriptions    Subscription[]
  accesses         CustomerAccess[]
  supportTickets   SupportTicket[]

  @@unique([tenantId, telegramId])
}

model CustomerAccess {
  id                     String    @id @default(uuid())
  customerId             String
  productId              String
  status                 String    // ACTIVE, EXPIRED, REVOKED
  expiresAt              DateTime?
  grantedAt              DateTime  @default(now())
  // Controle de idempotência da régua de cobrança (Cobrança automática) —
  // evita reenviar o mesmo lembrete de vencimento mais de uma vez.
  reminder3dSentAt       DateTime?
  reminder1dSentAt       DateTime?
  expiredReminderSentAt  DateTime?

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id])
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  totalAmount Float
  currency    String   @default("BRL")
  status      String   // PENDING, PAID, FAILED, CANCELLED, REFUNDED, EXPIRED
  createdAt   DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Float

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  orderId    String   @unique
  gateway    String   // MERCADO_PAGO, PUSHINPAY, ASAAS, STRIPE
  externalId String?  // ID do pagamento no gateway
  amount     Float
  status     String   // PENDING, APPROVED, REJECTED, REFUNDED
  method     String?  // PIX, CREDIT_CARD
  paymentUrl String?
  qrCode     String?
  createdAt  DateTime @default(now())
  updatedAt temporal.updatedAt()
  // Controle de idempotência da régua de cobrança de PIX pendente.
  pixReminder5SentAt  DateTime?
  pixReminder7SentAt  DateTime?
  pixReminder10SentAt DateTime?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentGatewayConnection {
  id           String    @id @default(uuid())
  tenantId     String
  gateway      String    // MERCADO_PAGO, PUSHINPAY, ASAAS, STRIPE
  accessToken  String    // Criptografado
  refreshToken String?   // Criptografado
  publicKey    String?
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt temporal.updatedAt()
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, gateway])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  tenantId    String
  provider    String    // MERCADO_PAGO, TELEGRAM
  eventId     String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId]) // garante idempotência
}

model Subscription {
  id          String    @id @default(uuid())
  tenantId    String
  customerId  String
  externalId  String?   // ID da assinatura no gateway
  status      String    // TRIAL, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  planName    String
  amount      Float
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  renewalAt   DateTime?
  cancelledAt DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id])
}

// ==========================================
// NOTIFICAÇÕES E AUTOMAÇÕES
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  type      String   // NEW_ORDER, PAYMENT_APPROVED, SUBSCRIPTION_EXPIRING
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Régua de mensagens automáticas enviadas pelo bot do tenant aos próprios
// clientes: lembrete de PIX gerado e não pago, e lembrete de vencimento de
// acesso. Mensagens aceitam as variáveis {nome}, {produto} e {vencimento}.
model BillingReminderSettings {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  pixReminderActive  Boolean  @default(true)
  pixMsg5            String   @default("Oi {nome}! 👋 Seu PIX para {produto} ainda está aguardando. Copie o código e finalize agora para garantir seu acesso!")
  pixMsg7            String   @default("⏳ {nome}, o PIX para {produto} continua em aberto. Não perca sua vaga!")
  pixMsg10           String   @default("⚠️ Última chamada, {nome}! O PIX para {produto} expira em breve. Finalize agora ou gere um novo no app.")
  planReminderActive Boolean  @default(true)
  planMsg3d          String   @default("Olá {nome}! Seu plano {produto} vence em 3 dias. Renove agora para não perder o acesso.")
  planMsg1d          String   @default("Atenção {nome}! Seu plano {produto} vence AMANHÃ. Renove agora!")
  planMsgExpired     String   @default("{nome}, seu plano {produto} expirou. Renove para continuar com acesso.")
  updatedAt temporal.updatedAt()

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Automation {
  id       String  @id @default(uuid())
  tenantId String
  trigger  String  // ON_PURCHASE, ON_SUBSCRIPTION_CANCEL, ON_SUBSCRIPTION_EXPIRING
  action   String  // SEND_TELEGRAM_MSG, GRANT_ACCESS, REVOKE_ACCESS
  config   Json
  isActive Boolean @default(true)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// SUPORTE
// ==========================================

model SupportTicket {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?  // cliente da loja, se aplicável
  creatorId  String?  // usuário do painel que abriu, se aplicável
  subject    String
  status     String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING, CLOSED
  createdAt  DateTime @default(now())
  updatedAt temporal.updatedAt()
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id])
  user       User?    @relation("TicketCreator", fields: [creatorId], references: [id])
  replies    SupportTicketReply[]
}

model SupportTicketReply {
  id             String  @id @default(uuid())
  ticketId       String
  userId         String? // vendedor/staff respondendo
  message        String
  isFromCustomer Boolean @default(false)
  createdAt      DateTime @default(now())

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])
}

// ==========================================
// AFILIADOS
// ==========================================

model Affiliate {
  id         String  @id @default(uuid())
  tenantId   String
  userId     String?
  code       String  @unique
  commission Float   // percentual
  isActive   Boolean @default(true)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals  Referral[]
}

model Referral {
  id               String   @id @default(uuid())
  affiliateId      String
  orderId          String   @unique
  commissionAmount Float
  status           String   // PENDING, PAID, REJECTED
  createdAt        DateTime @default(now())

  affiliate        Affiliate @relation(fields: [affiliateId], references: [id])
}

// ==========================================
// AUDITORIA
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String
  action     String   // CREATE_PRODUCT, DELETE_BOT, LOGIN, ...
  resource   String   // PRODUCT, BOT, USER, ...
  resourceId String?
  details    Json?    // valores antigos/novos — nunca tokens/segredos/senhas
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}
