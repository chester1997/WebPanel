generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// PLATAFORMA & MULTI-TENANCY
// ==========================================

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  telegramId    String?      @unique
  telegramUsername String?
  status        String       @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  supportTickets SupportTicket[] @relation("TicketCreator")
  ticketReplies SupportTicketReply[]
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  
  // Entidades comerciais e de configuração
  bots                  Bot[]
  miniAppSettings       MiniAppSettings?
  products              Product[]
  categories            Category[]
  coupons               Coupon[]
  contents              Content[]
  customers             Customer[]
  orders                Order[]
  payments              Payment[]
  subscriptions         Subscription[]
  paymentConnections    PaymentGatewayConnection[]
  webhookEvents         WebhookEvent[]
  notifications         Notification[]
  automations           Automation[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  platformSubscriptions PlatformSubscription[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

// ==========================================
// AUTENTICAÇÃO (Compatível com NextAuth/Auth.js)
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// BILLING DA PLATAFORMA (O VENDEDOR PAGA A PLATAFORMA)
// ==========================================

model Plan {
  id          String   @id @default(cuid())
  name        String   // STARTER, PRO, BUSINESS
  price       Float
  currency    String   @default("BRL")
  features    Json     // Ex: { "maxBots": 1, "maxProducts": 50 }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platformSubscriptions PlatformSubscription[]
}

model PlatformSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  planId    String
  status    String   // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  startedAt DateTime @default(now())
  expiresAt DateTime
  renewalAt DateTime?
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

// ==========================================
// TELEGRAM BOT & MINI APP
// ==========================================

model Bot {
  id          String   @id @default(cuid())
  tenantId    String
  botToken    String   // Deve ser criptografado!
  username    String
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config      BotConfiguration?
  webhook     TelegramWebhook?
}

model BotConfiguration {
  id        String   @id @default(cuid())
  botId     String   @unique
  welcomeMsg String? @db.Text
  
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model TelegramWebhook {
  id        String   @id @default(cuid())
  botId     String   @unique
  url       String
  secret    String   // Para validação de segurança
  isActive  Boolean  @default(true)

  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model MiniAppSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  storeName      String
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  description    String?  @db.Text
  
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  banners        MiniAppBanner[]
  sections       MiniAppSection[]
}

model MiniAppBanner {
  id          String   @id @default(cuid())
  settingsId  String
  imageUrl    String
  linkUrl     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  settings    MiniAppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

model MiniAppSection {
  id          String   @id @default(cuid())
  settingsId  String
  title       String
  type        String   // TOP_10, CATEGORY, RECENT
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  settings    MiniAppSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
}

// ==========================================
// PRODUTOS E CATÁLOGO
// ==========================================

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  order       Int      @default(0)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String?
  title           String
  slug            String
  description     String?  @db.Text
  imageUrl        String?
  status          String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  type            String   // DIGITAL, SUBSCRIPTION, BUNDLE, ACCESS
  periodicity     String?  // ONE_TIME, MONTHLY, YEARLY, LIFETIME
  deliveryType    String   // TELEGRAM_GROUP, EXTERNAL_LINK, MINI_APP_CONTENT
  deliveryContent String?  @db.Text // ID do grupo, link externo, etc
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id])
  prices          ProductPrice[]
  orderItems      OrderItem[]
  customerAccesses CustomerAccess[]
  coupons         Coupon[]
}

model ProductPrice {
  id               String   @id @default(cuid())
  productId        String
  price            Float
  promotionalPrice Float?
  currency         String   @default("BRL")
  isActive         Boolean  @default(true)

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String?
  code        String
  type        String   // PERCENTAGE, FIXED
  value       Float
  usageLimit  Int?
  usageCount  Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

// ==========================================
// CONTEÚDO DIGITAL (Player na Mini App)
// ==========================================

model Content {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?  @db.Text
  imageUrl    String?
  type        String   // MOVIE, SERIES, COURSE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seasons     Season[]
  media       Media?   // Se type == MOVIE
}

model Season {
  id          String   @id @default(cuid())
  contentId   String
  title       String
  order       Int      @default(0)

  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episodes    Episode[]
}

model Episode {
  id          String   @id @default(cuid())
  seasonId    String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  thumbnail   String?

  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  media       Media?
}

model Media {
  id              String   @id @default(cuid())
  contentId       String?  @unique
  episodeId       String?  @unique
  videoUrl        String?
  telegramFileId  String?
  duration        Int?     // em segundos

  content         Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

// ==========================================
// CLIENTES, PEDIDOS E PAGAMENTOS
// ==========================================

model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  name             String?
  email            String?
  telegramId       String   // ID vindo da Mini App / Bot
  telegramUsername String?
  status           String   @default("ACTIVE")
  totalSpent       Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  subscriptions    Subscription[]
  accesses         CustomerAccess[]
  
  @@unique([tenantId, telegramId])
}

model CustomerAccess {
  id        String   @id @default(cuid())
  customerId String
  productId String
  status    String   // ACTIVE, EXPIRED, REVOKED
  expiresAt DateTime?
  grantedAt DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Order {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  totalAmount Float
  currency    String   @default("BRL")
  status      String   // PENDING, PAID, FAILED, CANCELLED, REFUNDED, EXPIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payment     Payment?
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  price     Float

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String   @unique
  gateway     String   // MERCADO_PAGO, PUSHINPAY, STRIPE
  externalId  String?  // ID no Mercado Pago, etc
  amount      Float
  status      String   // PENDING, APPROVED, REJECTED, REFUNDED
  method      String?  // PIX, CREDIT_CARD
  paymentUrl  String?  @db.Text
  qrCode      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentGatewayConnection {
  id            String   @id @default(cuid())
  tenantId      String
  gateway       String   // MERCADO_PAGO, etc
  accessToken   String   @db.Text // Criptografado
  refreshToken  String?  @db.Text // Criptografado
  publicKey     String?  @db.Text
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, gateway])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String   // MERCADO_PAGO, TELEGRAM
  eventId     String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId]) // Para idempotência
}

model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  externalId  String?  // ID da assinatura no Gateway
  status      String   // TRIAL, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  planName    String
  amount      Float
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  renewalAt   DateTime?
  cancelledAt DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id])
}

// ==========================================
// NOTIFICAÇÕES E SUPORTE
// ==========================================

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // NEW_ORDER, PAYMENT_APPROVED
  message     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Automation {
  id          String   @id @default(cuid())
  tenantId    String
  trigger     String   // ON_PURCHASE, ON_SUBSCRIPTION_CANCEL
  action      String   // SEND_TELEGRAM_MSG, GRANT_ACCESS
  config      Json
  isActive    Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?  // Opcional, se o cliente ainda não existir mas for suporte via bot
  creatorId   String?  // Se criado pelo painel
  subject     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation("TicketCreator", fields: [creatorId], references: [id])
  replies     SupportTicketReply[]
}

model SupportTicketReply {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String?  // Vendedor ou Staff respondendo
  message     String   @db.Text
  isFromCustomer Boolean @default(false)
  createdAt   DateTime @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id])
}

// ==========================================
// AFILIADOS E MARKETING
// ==========================================

model Affiliate {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?  // Se for um afiliado cadastrado
  code        String   @unique
  commission  Float    // Percentual
  isActive    Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

model Referral {
  id          String   @id @default(cuid())
  affiliateId String
  orderId     String   @unique
  commissionAmount Float
  status      String   // PENDING, PAID, REJECTED
  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
}

// ==========================================
// AUDITORIA
// ==========================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String
  action      String   // CREATE_PRODUCT, DELETE_BOT, LOGIN
  resource    String   // PRODUCT, BOT, USER
  resourceId  String?
  details     Json?    // Mudanças, valores antigos/novos
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}
